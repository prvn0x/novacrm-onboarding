# Copy to .env (git-ignored). Never commit real values.
GEMINI_API_KEY=
LLM_MODEL=gemini-3.5-flash-lite
ROCKETLANE_API_KEY=
ROCKETLANE_BASE_URL=https://api.rocketlane.com/api/1.0
ROCKETLANE_APP_URL=https://app.rocketlane.com
VAPI_API_KEY=
VAPI_ASSISTANT_ID=
VAPI_PHONE_NUMBER_ID=
VAPI_PUBLIC_KEY=
# Modes: VOICE_MODE=phone|web (web = the same assistant in the browser), SLACK_MODE=real|console
VOICE_MODE=phone
SLACK_MODE=real
SLACK_BOT_TOKEN=
GMAIL_CREDENTIALS=var/gmail-credentials.json
# Timing: production values; the demo shortens the call spacing.
CALL_SPACING_SECONDS=900
OUTAGE_RETRY_SECONDS=300
POLL_SECONDS=30
